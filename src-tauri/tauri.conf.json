{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Discord Cache Recovery",
  "version": "4.0.0",
  "identifier": "com.azmekk.discordcacherecovery",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Discord Cache Recovery",
        "width": 1320,
        "height": 840,
        "minWidth": 920,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: media: http://media.localhost; media-src 'self' media: http://media.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
